# Required only for the `openai` provider. The harness never reads or prints .env files.
OPENAI_API_KEY=

# Use `codex` to consume the signed-in ChatGPT/Codex subscription instead of API billing.
CHEETCODE_MODEL_PROVIDER=codex
CHEETCODE_CODEX_EXECUTABLE=codex
CHEETCODE_CODEX_BATCH_SIZE=25

# Optional model overrides.
CHEETCODE_FAST_MODEL=gpt-5.6-luna
CHEETCODE_STRONG_MODEL=gpt-5.6-terra
CHEETCODE_SYSTEMS_MODEL=gpt-5.6-sol
CHEETCODE_SAFETY_IDENTIFIER=cheetcode-v3-local-harness

# Optional. `priority` can reduce latency when the API project supports Fast mode.
CHEETCODE_SERVICE_TIER=auto

# Browser bridge timing and verification gates.
CHEETCODE_BRIDGE_RESERVE_MS=8000
CHEETCODE_BRIDGE_REPAIR_RESERVE_MS=12000
CHEETCODE_BRIDGE_CHECK_TIMEOUT_MS=8000
CHEETCODE_BRIDGE_POLL_MS=100
CHEETCODE_BRIDGE_VERIFICATION_TTL_MS=300000
CHEETCODE_BROWSER_WORKER_CONCURRENCY=2
CHEETCODE_BROWSER_SIMPLE_BATCH_SIZE=12
CHEETCODE_BROWSER_COMPLEX_BATCH_SIZE=4
CHEETCODE_BROWSER_STRATEGY=single-fast

# Best-effort subscription fan-out for a short timed level (set deliberately; not the default).
# CHEETCODE_BROWSER_STRATEGY=fanout-fast
# CHEETCODE_BROWSER_WORKER_CONCURRENCY=8
# CHEETCODE_BROWSER_SIMPLE_BATCH_SIZE=8
# CHEETCODE_BROWSER_COMPLEX_BATCH_SIZE=4
