# Required only for the `openai` provider. The harness never reads or prints .env files.
OPENAI_API_KEY=

# Use `codex` to consume the signed-in ChatGPT/Codex subscription instead of API billing.
VBH_MODEL_PROVIDER=openai
VBH_CODEX_EXECUTABLE=codex
VBH_CODEX_BATCH_SIZE=25

# Optional model overrides.
VBH_FAST_MODEL=gpt-5.6-luna
VBH_STRONG_MODEL=gpt-5.6-terra
VBH_SYSTEMS_MODEL=gpt-5.6-sol
VBH_SAFETY_IDENTIFIER=harness-v3-local-harness

# Optional. `priority` can reduce latency when the API project supports Fast mode.
VBH_SERVICE_TIER=auto

# Browser bridge timing and verification gates.
VBH_BRIDGE_RESERVE_MS=12000
VBH_BRIDGE_CHECK_TIMEOUT_MS=8000
VBH_BRIDGE_POLL_MS=100
VBH_BRIDGE_VERIFICATION_TTL_MS=300000
